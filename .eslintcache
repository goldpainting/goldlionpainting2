inting2\\src\\server\\db\\index.ts",[],[],"C:\\Users\\Usuario\\Documents\\DOC JOSE\\DEV\\goldpainting2\\src\\server\\db\\schema.ts",[],[],"C:\\Users\\Usuario\\Documents\\DOC JOSE\\DEV\\goldpainting2\\src\\server\\email.ts",[],[],{"ruleId":"789","severity":2,"message":"790","line":206,"column":7,"nodeType":null,"endLine":206,"endColumn":14},{"ruleId":"791","severity":1,"message":"792","line":75,"column":5,"nodeType":"793","endLine":83,"endColumn":7,"suppressions":"794"},{"ruleId":"789","severity":2,"message":"795","line":206,"column":7,"endLine":206,"endColumn":14},{"ruleId":"791","severity":1,"message":"792","line":75,"column":5,"endLine":83,"endColumn":7,"suppressions":"796"},"react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\Usuario\\Documents\\DOC JOSE\\DEV\\goldpainting\\src\\app\\components\\GoogleReviewsCarousel.tsx:206:7\n  204 |   useEffect(() => {\n  205 |     if (page > pages.length) {\n> 206 |       setPage(1);\n      |       ^^^^^^^ Avoid calling setState() directly within an effect\n  207 |     }\n  208 |   }, [page, pages.length]);\n  209 |","@next/next/no-img-element","Using `<img>` could result in slower LCP and higher bandwidth. Consider using `<Image />` from `next/image` or a custom image loader to automatically optimize images. This may incur additional usage or cost from your provider. See: https://nextjs.org/docs/messages/no-img-element","JSXOpeningElement",["797"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\Usuario\\Documents\\DOC JOSE\\DEV\\goldpainting2\\src\\app\\components\\GoogleReviewsCarousel.tsx:206:7\n  204 |   useEffect(() => {\n  205 |     if (page > pages.length) {\n> 206 |       setPage(1);\n      |       ^^^^^^^ Avoid calling setState() directly within an effect\n  207 |     }\n  208 |   }, [page, pages.length]);\n  209 |",["798"],{"kind":"799","justification":"800"},{"kind":"799","justification":"800"},"directive",""]